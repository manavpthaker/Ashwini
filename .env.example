# Ashwini runs as one Node process on the private host, serving both the PWA and
# its API on a single origin. Reach it over `tailscale serve`, never `tailscale
# funnel` — funnel is public ingress and PRD 11.3 forbids it.
#
# Only the Supabase project URL and low-privilege publishable key below use the
# NEXT_PUBLIC_ prefix; Supabase designs both for browser use. No server secret,
# database password, or elevated Supabase key may use that prefix. CI enforces
# the exact allowlist.

# --- Database -----------------------------------------------------------------
# Supabase Postgres, via Supavisor. The port depends on where this runs, and
# getting it wrong is the classic Supabase failure mode:
#
#   Vercel / serverless   -> TRANSACTION mode, port 6543
#   Mac mini / long-lived -> SESSION mode,     port 5432 (also IPv4-friendly)
#
# Migrations always use the session-mode/direct URL, never 6543.
#
# The project ref is hlykstavsipzjjmwlyou — it is also in .mcp.json and in the
# NEXT_PUBLIC_SUPABASE_URL below, because it is not a secret. The password and
# the region are; copy the full string from the Supabase dashboard rather than
# assembling it here. Ashwini enforces certificate and hostname verification
# for every non-loopback host. Insecure sslmode values are refused.
DATABASE_URL=postgres://postgres.hlykstavsipzjjmwlyou:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=verify-full

# Download the project's server root certificate from Supabase Dashboard ->
# Database Settings -> SSL Configuration, then paste the complete PEM value.
# Required for every non-loopback DATABASE_URL. Keep it server-only; never use
# a NEXT_PUBLIC_ name. Local and CI loopback databases do not need it.
ASHWINI_POSTGRES_CA=

# --- Locale -------------------------------------------------------------------
# Decides which day a meal or dose belongs to, and which time-of-day brief the
# user opens into. A product setting, not a formatting detail.
ASHWINI_TIME_ZONE=America/New_York

# Server-only random key (at least 32 characters). It peppers exact replay
# fingerprints so a database snapshot cannot dictionary-guess redacted crisis
# or therapy wording. Generate independently; never use a NEXT_PUBLIC_ name.
ASHWINI_INPUT_HMAC_KEY=

# --- Access -------------------------------------------------------------------
# Two modes, chosen by what is set. If Supabase auth is configured it is used;
# otherwise the Tailscale header gate applies. There is no flag to pick.
#
#   supabase  -> verifies a real session. Required for any public host.
#   tailscale -> trusts a header `tailscale serve` injects. Private hosts only.

# Mode A: Supabase auth. Needed on Vercel or anywhere reachable from the
# internet. All three are required together.
#
# The publishable key (`sb_publishable_...`) is meant to be public — it identifies
# the project and carries no elevated privileges; row-level security protects the
# data. The legacy NEXT_PUBLIC_SUPABASE_ANON_KEY name is accepted as a fallback.
NEXT_PUBLIC_SUPABASE_URL=https://hlykstavsipzjjmwlyou.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback only:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Who may hold a session. Single-subject product, so normally exactly one.
# Without this, any account that can sign in to the Supabase project could too.
ASHWINI_ALLOWED_EMAILS=you@example.com

# Mode B: the private deployment. Every node on the tailnet can reach the host,
# so "no public ingress" is not "no auth" — proxy.ts checks this against the
# header `tailscale serve` injects.
# ASHWINI_TAILSCALE_USER=you@example.com

# Tailscale mode only. Set to 0 for local development. Refused in production.
ASHWINI_REQUIRE_IDENTITY=1

# --- Scheduler ----------------------------------------------------------------
# Authenticates /api/reminders/run, which has no session to present. The route
# refuses to run at all when this is unset.
#
# On Vercel set CRON_SECRET: that name is Vercel's own, and it is the value it
# signs the Authorization header with. ASHWINI_CRON_SECRET is accepted too and
# is the one to use for a launchd timer or any other self-hosted scheduler.
CRON_SECRET=

# --- External evidence --------------------------------------------------------
# Server credential for Examine Connect's supplement-drug and
# supplement-supplement safety endpoint. It does not cover drug-drug, efficacy,
# or dosing. Never expose this to the client.
EXAMINE_CONNECT_API_KEY=

# Optional context-aware reasoning. All three required; otherwise rules-only.
# Setting consent means the owner explicitly agreed to send selected health
# context/check-ins to OpenAI. Never set this just because a key exists.
# store:false is used, but does not promise zero provider retention. See PRIVACY.
# OPENAI_API_KEY=
# ASHWINI_MODEL=gpt-6-astra
# ASHWINI_MODEL_CONTEXT_CONSENT=openai-v1

# --- Development only ---------------------------------------------------------
# Seeds synthetic fixtures. Refused when NODE_ENV=production.
ASHWINI_ALLOW_SEED=0

# Points the Electron shell at a dev server instead of the packaged build.
# ASHWINI_DEV_SERVER_URL=http://127.0.0.1:3000

# Throwaway Postgres for integration tests. Never a Supabase URL.
# ASHWINI_TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/ashwini_test
