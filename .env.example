# Ashwini runs as one Node process on the private host, serving both the PWA and
# its API on a single origin. Reach it over `tailscale serve`, never `tailscale
# funnel` — funnel is public ingress and PRD 11.3 forbids it.
#
# Nothing here is NEXT_PUBLIC_. Anything with that prefix is compiled into the
# browser bundle, and CI fails the build if a NEXT_PUBLIC_ variable is named
# like a credential.

# --- Database -----------------------------------------------------------------
# Supabase Postgres, via the Supavisor SESSION mode pooler (port 5432).
# Direct connections are IPv6-only unless the IPv4 add-on is enabled; port 6543
# is transaction mode and is meant for serverless, not a long-lived process.
DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Locale -------------------------------------------------------------------
# Decides which day a meal or dose belongs to, and which time-of-day brief the
# user opens into. A product setting, not a formatting detail.
ASHWINI_TIME_ZONE=America/New_York

# --- Access -------------------------------------------------------------------
# "No public ingress" is not "no auth": every node on the tailnet can reach this
# host. `tailscale serve` injects Tailscale-User-Login and proxy.ts checks it.
ASHWINI_TAILSCALE_USER=you@example.com

# Set to 0 for local development only. Refused at boot in production.
ASHWINI_REQUIRE_IDENTITY=1

# --- External evidence --------------------------------------------------------
# Server credential for Examine Connect's supplement-drug and
# supplement-supplement safety endpoint. It does not cover drug-drug, efficacy,
# or dosing. Never expose this to the client.
EXAMINE_CONNECT_API_KEY=

# --- Development only ---------------------------------------------------------
# Seeds synthetic fixtures. Refused when NODE_ENV=production.
ASHWINI_ALLOW_SEED=0

# Points the Electron shell at a dev server instead of the packaged build.
# ASHWINI_DEV_SERVER_URL=http://127.0.0.1:3000

# Throwaway Postgres for integration tests. Never a Supabase URL.
# ASHWINI_TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/ashwini_test
