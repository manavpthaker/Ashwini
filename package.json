{
  "name": "ashwini",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "desktop:dev": "concurrently -k \"pnpm dev\" \"wait-on http://127.0.0.1:3000 && ASHWINI_DEV_SERVER_URL=http://127.0.0.1:3000 electron .\"",
    "desktop:build": "pnpm build && electron-builder",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p tsconfig.strict.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:apply": "tsx scripts/apply-migrations.ts",
    "db:seed": "tsx scripts/seed.ts",
    "health:import": "tsx scripts/import-health-context.ts",
    "health:apple": "tsx scripts/import-apple-health.ts"
  },
  "main": "desktop/main.cjs",
  "dependencies": {
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "kysely": "^0.29.5",
    "next": "16.3.1",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "saxes": "^6.0.0",
    "server-only": "^0.0.1",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^10.0.5",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.3",
    "eslint-config-next": "16.3.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "5.9.2",
    "vitest": "^4.1.11",
    "wait-on": "^9.1.0"
  },
  "packageManager": "pnpm@10.14.0",
  "build": {
    "appId": "health.ashwini.desktop",
    "productName": "ashwini",
    "files": [
      "desktop/**",
      "out/**",
      "public/**",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.healthcare-fitness"
    }
  }
}
